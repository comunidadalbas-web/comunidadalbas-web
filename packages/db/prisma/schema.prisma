generator client {
  provider = "prisma-client"
  output   = "./client"
}

datasource db {
  provider = "postgresql"
}

enum RecordStatus {
  ACTIVE
  ARCHIVED
}

enum PaymentStatus {
  REPORTED
  CONFIRMED
  APPLIED
  CLARIFICATION
  REJECTED
  DUPLICATE
}

enum ExpenseStatus {
  REQUESTED
  AUTHORIZED
  PAID
  VERIFIED
  RECONCILED
  REJECTED
}

enum Visibility {
  PUBLIC
  PRIVATE
  RESTRICTED
}

enum ContactRequestStatus {
  NEW
  IN_REVIEW
  RESOLVED
  ARCHIVED
}

enum AnnouncementStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

enum CampaignStatus {
  DRAFT
  ACTIVE
  COMPLETED
  CANCELLED
}

enum CalendarEventStatus {
  SCHEDULED
  COMPLETED
  CANCELLED
}

enum BlogPostStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

enum BlogCommentStatus {
  PENDING
  PUBLISHED
  REJECTED
  ARCHIVED
}

model Building {
  id        String       @id @default(cuid())
  code      String       @unique
  name      String
  status    RecordStatus @default(ACTIVE)
  units     Unit[]
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt
}

model Unit {
  id              String       @id @default(cuid())
  code            String       @unique
  apartmentNumber String
  buildingId      String
  building        Building     @relation(fields: [buildingId], references: [id])
  status          RecordStatus @default(ACTIVE)
  charges         Charge[]
  payments        Payment[]
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt
  @@unique([buildingId, apartmentNumber])
}

model FeeConcept {
  id              String       @id @default(cuid())
  name            String
  amount          Decimal      @db.Decimal(12, 2)
  authoritySource String
  status          RecordStatus @default(ACTIVE)
  charges         Charge[]
}

model Charge {
  id           String              @id @default(cuid())
  unitId       String
  unit         Unit                @relation(fields: [unitId], references: [id])
  feeConceptId String
  feeConcept   FeeConcept          @relation(fields: [feeConceptId], references: [id])
  period       String
  amount       Decimal             @db.Decimal(12, 2)
  dueDate      DateTime?
  payments     PaymentApplication[]
  @@unique([unitId, feeConceptId, period])
}

model Payment {
  id                String              @id @default(cuid())
  unitId            String
  unit              Unit                @relation(fields: [unitId], references: [id])
  paidAt            DateTime?
  reportedAt        DateTime            @default(now())
  amount            Decimal             @db.Decimal(12, 2)
  reference         String?
  trackingKey       String?             @unique
  providerMovementId String?            @unique
  status            PaymentStatus       @default(REPORTED)
  applications      PaymentApplication[]
  createdById       String?
  createdAt         DateTime            @default(now())
  updatedAt         DateTime            @updatedAt
}

model PaymentApplication {
  id        String  @id @default(cuid())
  paymentId String
  payment   Payment @relation(fields: [paymentId], references: [id])
  chargeId  String
  charge    Charge  @relation(fields: [chargeId], references: [id])
  amount    Decimal @db.Decimal(12, 2)
  @@unique([paymentId, chargeId])
}

model Expense {
  id              String        @id @default(cuid())
  spentAt         DateTime?
  category        String
  provider        String?
  description     String
  amount          Decimal       @db.Decimal(12, 2)
  fund            String
  status          ExpenseStatus @default(REQUESTED)
  evidenceUrl     String?
  requestedById   String?
  authorizedById  String?
  reconciledById  String?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
}

model Document {
  id         String     @id @default(cuid())
  title      String
  category   String
  version    String
  visibility Visibility @default(RESTRICTED)
  fileUrl    String
  sha256     String
  approvedAt DateTime?
  createdAt  DateTime   @default(now())
}

model Announcement {
  id          String             @id @default(cuid())
  title       String
  body        String
  category    String
  status      AnnouncementStatus @default(DRAFT)
  publishedAt DateTime?
  createdById String?
  createdAt   DateTime           @default(now())
  updatedAt   DateTime           @updatedAt
}

model Campaign {
  id           String         @id @default(cuid())
  title        String
  description  String
  imageUrl      String?
  imageAlt      String?
  goalAmount   Decimal?       @db.Decimal(12, 2)
  collectedAmount Decimal     @default(0) @db.Decimal(12, 2)
  status       CampaignStatus @default(DRAFT)
  startsAt     DateTime?
  endsAt       DateTime?
  createdById  String?
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt
}

model CalendarEvent {
  id          String             @id @default(cuid())
  title       String
  description String?
  location    String?
  startsAt    DateTime
  endsAt      DateTime?
  status      CalendarEventStatus @default(SCHEDULED)
  createdById String?
  createdAt   DateTime           @default(now())
  updatedAt   DateTime           @updatedAt
}

model BlogPost {
  id             String          @id @default(cuid())
  title          String
  slug           String          @unique
  summary        String?
  content        String
  coverImageUrl  String?
  coverImageAlt  String?
  status         BlogPostStatus  @default(DRAFT)
  commentsEnabled Boolean        @default(false)
  authorId       String
  author         User            @relation(fields: [authorId], references: [id])
  comments       BlogComment[]
  publishedAt    DateTime?
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
  @@index([status, publishedAt])
}

model User {
  id                 String          @id @default(cuid())
  email              String          @unique
  displayName        String
  passwordHash       String
  active             Boolean         @default(true)
  mustChangePassword Boolean         @default(false)
  lastLoginAt        DateTime?
  roles              RoleAssignment[]
  auditLogs          AuditLog[]
  blogPosts          BlogPost[]
  passwordResetTokens PasswordResetToken[]
  createdAt          DateTime        @default(now())
  updatedAt          DateTime        @updatedAt
}

model PasswordResetToken {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String   @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime @default(now())
  @@index([userId, createdAt])
  @@index([expiresAt])
}

model BlogComment {
  id                String            @id @default(cuid())
  postId            String
  post              BlogPost          @relation(fields: [postId], references: [id], onDelete: Cascade)
  parentId          String?
  parent            BlogComment?      @relation("BlogCommentReplies", fields: [parentId], references: [id], onDelete: Cascade)
  replies           BlogComment[]     @relation("BlogCommentReplies")
  displayName       String
  email             String
  body              String
  status            BlogCommentStatus @default(PENDING)
  isInstitutional   Boolean           @default(false)
  ipHash            String?
  userAgentHash     String?
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt
  @@index([postId, status, parentId, createdAt])
  @@index([parentId, status, createdAt])
}

model RoleAssignment {
  id     String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id])
  role   String
  @@unique([userId, role])
}

model AuditLog {
  id         String   @id @default(cuid())
  userId     String?
  user       User?    @relation(fields: [userId], references: [id])
  action     String
  entityType String
  entityId   String?
  before     Json?
  after      Json?
  createdAt  DateTime @default(now())
}

model ContactRequest {
  id              String               @id @default(cuid())
  folio           String?              @unique
  name            String
  email           String
  phone           String?
  building        String?
  apartment       String?
  category        String
  message         String
  privacyAccepted Boolean              @default(true)
  status          ContactRequestStatus @default(NEW)
  notifiedAt      DateTime?
  notes           String?
  createdAt       DateTime             @default(now())
  updatedAt       DateTime             @updatedAt
}

model MercadoPagoOrder {
  id                       String   @id @default(cuid())
  orderId                  String   @unique
  externalReference        String
  status                   String
  statusDetail             String?
  paymentId                String?
  reference                String?
  ticketUrl                String?
  expiresAt                DateTime?
  amount                   Decimal  @db.Decimal(12, 2)
  environment              String   @default("test")
  idempotencyKey           String
  isPilot                  Boolean  @default(false)
  excludeFromCommunityBalance Boolean @default(false)
  feeConceptId             String?
  feeConceptName           String?
  payerName                String?
  payerEmail               String?
  building                 String?
  apartment                String?
  rawResponse              Json?
  webhookEvents            MercadoPagoWebhookEvent[]
  createdAt                DateTime @default(now())
  updatedAt                DateTime @updatedAt
}

model MercadoPagoWebhookEvent {
  id                 String   @id @default(cuid())
  orderId            String?
  order              MercadoPagoOrder? @relation(fields: [orderId], references: [orderId])
  topic              String
  resource           String
  action             String?
  xRequestId         String?
  signatureValid     Boolean  @default(false)
  signatureError     String?
  duplicate          Boolean  @default(false)
  rawPayload         Json?
  processed          Boolean  @default(false)
  processResult      String?
  processError       String?
  createdAt          DateTime @default(now())
}

model RateLimitEntry {
  id        String   @id @default(cuid())
  key       String
  createdAt DateTime @default(now())
  @@index([key, createdAt])
}
