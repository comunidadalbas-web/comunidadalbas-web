# --- Database ---
DATABASE_URL=postgresql://albas:albas_dev@localhost:55432/comunidad_albas?schema=public

# --- Site ---
NEXT_PUBLIC_SITE_URL=http://localhost:3000
SITE_NAME=Comunidad Albas
SITE_DESCRIPTION=Portal institucional de Privada Albas

# --- Security ---
SESSION_SECRET=replace-with-at-least-32-random-characters
CSRF_SECRET=replace-with-another-32-random-characters

# --- Admin auth (Fase B) ---
# URL absoluta para validación de origen en mutaciones admin
APP_URL=https://comunidadalbas.com.mx
ADMIN_API_KEY=

# --- Mercado Pago ---
# Mantener test y production estrictamente separados. Nunca versionar valores reales.
MERCADOPAGO_ENV=test
MERCADOPAGO_ACCESS_TOKEN_TEST=
MERCADOPAGO_ACCESS_TOKEN_PROD=
MERCADOPAGO_WEBHOOK_SECRET_TEST=
MERCADOPAGO_WEBHOOK_SECRET_PROD=
PAYMENTS_ENABLED=false
PAYMENTS_PILOT_ENABLED=false
PAYMENTS_ALLOWED_EMAILS=
PAYMENTS_CUOTA_AMOUNT=100.00
PAYMENTS_MAX_EXTRAORDINARY=10000.00
PILOT_PAYMENT_AMOUNT=200.00

# --- Email (Zoho SMTP) ---
# Host/credenciales del buzón institucional. SMTP_SECURE=true para el puerto 465 (SSL),
# false para 587 (STARTTLS). Si SMTP_USER/SMTP_PASS están vacíos, los envíos fallan
# silenciosamente y no bloquean el flujo de la app.
SMTP_HOST=smtp.zoho.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=contacto@comunidadalbas.com.mx
# Destinatario de las notificaciones internas de nuevas solicitudes
CONTACT_NOTIFICATION_EMAIL=contacto@comunidadalbas.com.mx
# URL pública para enlaces dentro de los correos (reemplaza a NEXT_PUBLIC_SITE_URL en el env de la app)

# --- Storage (evaluate Vercel Blob or similar later) ---
STORAGE_BUCKET=

# --- Feature Flags ---
INSTITUTIONAL_STATUS=pending
AC_EXISTING=false
