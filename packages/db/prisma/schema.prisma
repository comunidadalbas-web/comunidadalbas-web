generator client {
  provider = "prisma-client"
  output   = "./client"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum RecordStatus {
  ACTIVE
  ARCHIVED
}

enum PaymentStatus {
  REPORTED
  CONFIRMED
  APPLIED
  CLARIFICATION
  REJECTED
  DUPLICATE
}

enum ExpenseStatus {
  REQUESTED
  AUTHORIZED
  PAID
  VERIFIED
  RECONCILED
  REJECTED
}

enum Visibility {
  PUBLIC
  PRIVATE
  RESTRICTED
}

enum ContactRequestStatus {
  NEW
  IN_REVIEW
  RESOLVED
  ARCHIVED
}

enum AnnouncementStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

enum CampaignStatus {
  DRAFT
  ACTIVE
  COMPLETED
  CANCELLED
}

enum CalendarEventStatus {
  SCHEDULED
  COMPLETED
  CANCELLED
}

enum BlogPostStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

enum BlogCommentStatus {
  PENDING
  PUBLISHED
  REJECTED
  ARCHIVED
}

enum LeaseStatus {
  DRAFT
  ACTIVE
  RENEWAL_PENDING
  EXPIRED
  TERMINATED
}

enum TicketStatus {
  OPEN
  IN_PROGRESS
  RESOLVED
  CLOSED
}

enum TicketPriority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

enum InventoryCondition {
  NEW
  GOOD
  FAIR
  POOR
  DAMAGED
}

model Property {
  id            String       @id @default(cuid())
  code          String       @unique
  name          String
  type          String       @default("Departamento")
  state         String?
  municipality  String?
  development   String?
  privateArea   String?
  unitNumber    String?
  areaM2        Decimal?     @db.Decimal(8, 2)
  parkingSpace  String?
  use           String       @default("Habitacional")
  status        RecordStatus @default(ACTIVE)
  notes         String?
  units         Unit[]
  tenants       Tenant[]
  leases        Lease[]
  expenses      PropertyExpense[]
  tickets       MaintenanceTicket[]
    documents     PropertyDocument[]
    taxRecords    TaxRecord[]
    inventories   AssetInventory[]
    administrationFees AdministrationFee[]
    createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt
}

model Building {
  id        String       @id @default(cuid())
  code      String       @unique
  name      String
  status    RecordStatus @default(ACTIVE)
  units     Unit[]
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt
}

model Unit {
  id              String       @id @default(cuid())
  code            String       @unique
  apartmentNumber String
  buildingId      String
  building        Building     @relation(fields: [buildingId], references: [id])
  propertyId      String?
  property        Property?    @relation(fields: [propertyId], references: [id])
  status          RecordStatus @default(ACTIVE)
  charges         Charge[]
  payments        Payment[]
  leases          Lease[]
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt

  @@unique([buildingId, apartmentNumber])
}

model FeeConcept {
  id              String       @id @default(cuid())
  name            String
  amount          Decimal      @db.Decimal(12, 2)
  authoritySource String
  status          RecordStatus @default(ACTIVE)
  charges         Charge[]
}

model Charge {
  id           String               @id @default(cuid())
  unitId       String
  unit         Unit                 @relation(fields: [unitId], references: [id])
  feeConceptId String
  feeConcept   FeeConcept           @relation(fields: [feeConceptId], references: [id])
  period       String
  amount       Decimal              @db.Decimal(12, 2)
  dueDate      DateTime?
  payments     PaymentApplication[]

  @@unique([unitId, feeConceptId, period])
}

model Payment {
  id                 String               @id @default(cuid())
  unitId             String
  unit               Unit                 @relation(fields: [unitId], references: [id])
  paidAt             DateTime?
  reportedAt         DateTime             @default(now())
  amount             Decimal              @db.Decimal(12, 2)
  reference          String?
  trackingKey        String?              @unique
  providerMovementId String?              @unique
  status             PaymentStatus        @default(REPORTED)
  applications       PaymentApplication[]
  createdById        String?
  createdAt          DateTime             @default(now())
  updatedAt          DateTime             @updatedAt
}

model PaymentApplication {
  id        String  @id @default(cuid())
  paymentId String
  payment   Payment @relation(fields: [paymentId], references: [id])
  chargeId  String
  charge    Charge  @relation(fields: [chargeId], references: [id])
  amount    Decimal @db.Decimal(12, 2)

  @@unique([paymentId, chargeId])
}

model Expense {
  id             String        @id @default(cuid())
  spentAt        DateTime?
  category       String
  provider       String?
  description    String
  amount         Decimal       @db.Decimal(12, 2)
  fund           String
  status         ExpenseStatus @default(REQUESTED)
  evidenceUrl    String?
  requestedById  String?
  authorizedById String?
  reconciledById String?
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt
}

model Document {
  id              String     @id @default(cuid())
  title           String
  description     String?
  category        String
  version         String
  documentDate    DateTime?
  visibility      Visibility @default(RESTRICTED)
  fileUrl         String
  fileSizeBytes   Int?
  storageProvider String     @default("EXTERNAL")
  storageKey      String?
  sha256          String
  isPermanent     Boolean    @default(false)
  approvedAt      DateTime?
  createdAt       DateTime   @default(now())
  updatedAt       DateTime   @updatedAt

  @@index([visibility, approvedAt, category, documentDate])
}

model Announcement {
  id          String             @id @default(cuid())
  title       String
  body        String
  category    String
  status      AnnouncementStatus @default(DRAFT)
  publishedAt DateTime?
  createdById String?
  createdAt   DateTime           @default(now())
  updatedAt   DateTime           @updatedAt
}

model Campaign {
  id              String         @id @default(cuid())
  title           String
  description     String
  imageUrl        String?
  imageAlt        String?
  goalAmount      Decimal?       @db.Decimal(12, 2)
  collectedAmount Decimal        @default(0) @db.Decimal(12, 2)
  status          CampaignStatus @default(DRAFT)
  startsAt        DateTime?
  endsAt          DateTime?
  createdById     String?
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt
}

model CalendarEvent {
  id          String              @id @default(cuid())
  title       String
  description String?
  location    String?
  startsAt    DateTime
  endsAt      DateTime?
  status      CalendarEventStatus @default(SCHEDULED)
  createdById String?
  createdAt   DateTime            @default(now())
  updatedAt   DateTime            @updatedAt
}

model BlogPost {
  id              String         @id @default(cuid())
  title           String
  slug            String         @unique
  summary         String?
  content         String
  coverImageUrl   String?
  coverImageAlt   String?
  status          BlogPostStatus @default(DRAFT)
  commentsEnabled Boolean        @default(false)
  authorId        String
  author          User           @relation(fields: [authorId], references: [id])
  comments        BlogComment[]
  publishedAt     DateTime?
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt

  @@index([status, publishedAt])
}

model User {
  id                  String               @id @default(cuid())
  email               String               @unique
  displayName         String
  passwordHash        String
  active              Boolean              @default(true)
  mustChangePassword  Boolean              @default(false)
  lastLoginAt         DateTime?
  roles               RoleAssignment[]
  auditLogs           AuditLog[]
  blogPosts           BlogPost[]
  passwordResetTokens PasswordResetToken[]
  createdAt           DateTime             @default(now())
  updatedAt           DateTime             @updatedAt
}

model PasswordResetToken {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId, createdAt])
  @@index([expiresAt])
}

model BlogComment {
  id              String            @id @default(cuid())
  postId          String
  post            BlogPost          @relation(fields: [postId], references: [id], onDelete: Cascade)
  parentId        String?
  parent          BlogComment?      @relation("BlogCommentReplies", fields: [parentId], references: [id], onDelete: Cascade)
  replies         BlogComment[]     @relation("BlogCommentReplies")
  displayName     String
  email           String
  body            String
  status          BlogCommentStatus @default(PENDING)
  isInstitutional Boolean           @default(false)
  ipHash          String?
  userAgentHash   String?
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt

  @@index([postId, status, parentId, createdAt])
  @@index([parentId, status, createdAt])
}

model RoleAssignment {
  id     String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id])
  role   String

  @@unique([userId, role])
}

model AuditLog {
  id         String   @id @default(cuid())
  userId     String?
  user       User?    @relation(fields: [userId], references: [id])
  action     String
  entityType String
  entityId   String?
  before     Json?
  after      Json?
  createdAt  DateTime @default(now())
}

model ContactRequest {
  id              String               @id @default(cuid())
  folio           String?              @unique
  name            String
  email           String
  phone           String?
  building        String?
  apartment       String?
  category        String
  message         String
  privacyAccepted Boolean              @default(true)
  status          ContactRequestStatus @default(NEW)
  notifiedAt      DateTime?
  notes           String?
  createdAt       DateTime             @default(now())
  updatedAt       DateTime             @updatedAt
}

model MercadoPagoOrder {
  id                          String                    @id @default(cuid())
  orderId                     String                    @unique
  externalReference           String
  status                      String
  statusDetail                String?
  paymentId                   String?
  reference                   String?
  ticketUrl                   String?
  expiresAt                   DateTime?
  amount                      Decimal                   @db.Decimal(12, 2)
  environment                 String                    @default("test")
  idempotencyKey              String
  isPilot                     Boolean                   @default(false)
  excludeFromCommunityBalance Boolean                   @default(false)
  feeConceptId                String?
  feeConceptName              String?
  payerName                   String?
  payerEmail                  String?
  building                    String?
  apartment                   String?
  rawResponse                 Json?
  webhookEvents               MercadoPagoWebhookEvent[]
  createdAt                   DateTime                  @default(now())
  updatedAt                   DateTime                  @updatedAt
}

model MercadoPagoWebhookEvent {
  id             String            @id @default(cuid())
  orderId        String?
  order          MercadoPagoOrder? @relation(fields: [orderId], references: [orderId])
  topic          String
  resource       String
  action         String?
  xRequestId     String?
  signatureValid Boolean           @default(false)
  signatureError String?
  duplicate      Boolean           @default(false)
  rawPayload     Json?
  processed      Boolean           @default(false)
  processResult  String?
  processError   String?
  createdAt      DateTime          @default(now())
}

model RateLimitEntry {
  id        String   @id @default(cuid())
  key       String
  createdAt DateTime @default(now())

  @@index([key, createdAt])
}

model Tenant {
  id            String       @id @default(cuid())
  propertyId    String
  property      Property     @relation(fields: [propertyId], references: [id])
  firstName     String
  lastName      String
  email         String?
  phone         String?
  altPhone      String?
  idType        String?
  idNumber      String?
  emergencyName String?
  emergencyPhone String?
  notes         String?
  status        RecordStatus @default(ACTIVE)
  leases        Lease[]
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt
}

model Lease {
  id            String       @id @default(cuid())
  propertyId    String
  property      Property     @relation(fields: [propertyId], references: [id])
  unitId        String?
  unit          Unit?        @relation(fields: [unitId], references: [id])
  tenantId      String
  tenant        Tenant       @relation(fields: [tenantId], references: [id])
  code          String       @unique
  status        LeaseStatus  @default(DRAFT)
  startDate     DateTime
  endDate       DateTime
  monthlyRent   Decimal      @db.Decimal(12, 2)
  depositAmount Decimal      @db.Decimal(12, 2) @default(0)
  paymentDay    Int          @default(1)
  guaranteeType String?
  guaranteeAmount Decimal?   @db.Decimal(12, 2)
  petsAllowed   Boolean      @default(false)
  vehicles      String?
  notes         String?
  occupants     LeaseOccupant[]
  charges       LeaseCharge[]
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt

  @@index([propertyId, status])
  @@index([tenantId])
}

model LeaseOccupant {
  id        String   @id @default(cuid())
  leaseId   String
  lease     Lease    @relation(fields: [leaseId], references: [id], onDelete: Cascade)
  name      String
  relation  String?
  idType    String?
  idNumber  String?
  isPrimary Boolean  @default(false)
  createdAt DateTime @default(now())
}

model LeaseCharge {
  id          String   @id @default(cuid())
  leaseId     String
  lease       Lease    @relation(fields: [leaseId], references: [id], onDelete: Cascade)
  concept     String
  amount      Decimal  @db.Decimal(12, 2)
  period      String
  dueDate     DateTime?
  status      String   @default("PENDING")
  notes       String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([leaseId, period])
}

model SecurityDeposit {
  id          String   @id @default(cuid())
  leaseId     String
  amount      Decimal  @db.Decimal(12, 2)
  receivedAt  DateTime
  returnedAt  DateTime?
  returnAmount Decimal? @db.Decimal(12, 2)
  notes       String?
  createdAt   DateTime @default(now())
}

model AdministrationFee {
    id            String   @id @default(cuid())
    propertyId    String
    property      Property @relation(fields: [propertyId], references: [id])
    name          String
    amount        Decimal  @db.Decimal(12, 2)
    periodicity   String   @default("Mensual")
    beneficiary   String?
    startDate     DateTime
    endDate       DateTime?
    status        RecordStatus @default(ACTIVE)
    notes         String?
    createdAt     DateTime @default(now())
    updatedAt     DateTime @updatedAt
  
    @@index([propertyId, status])
  }

model PropertyExpense {
  id            String       @id @default(cuid())
  propertyId    String
  property      Property     @relation(fields: [propertyId], references: [id])
  category      String
  description   String
  amount        Decimal      @db.Decimal(12, 2)
  spentAt       DateTime?
  provider      String?
  evidenceUrl   String?
  fund          String?
  status        ExpenseStatus @default(REQUESTED)
  requestedById String?
  authorizedById String?
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt

  @@index([propertyId, category])
}

model MaintenanceTicket {
  id            String       @id @default(cuid())
  propertyId    String
  property      Property     @relation(fields: [propertyId], references: [id])
  title         String
  description   String?
  priority      TicketPriority @default(MEDIUM)
  status        TicketStatus   @default(OPEN)
  assignedTo    String?
  reportedAt    DateTime     @default(now())
  resolvedAt    DateTime?
  cost          Decimal?     @db.Decimal(12, 2)
  notes         String?
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt

  @@index([propertyId, status])
}

model AssetInventory {
  id            String       @id @default(cuid())
  propertyId    String
  property      Property     @relation(fields: [propertyId], references: [id])
  name          String
  category      String?
  description   String?
  quantity      Int          @default(1)
  condition     InventoryCondition @default(GOOD)
  location      String?
  notes         String?
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt

  @@index([propertyId, category])
}

model PropertyDocument {
  id            String     @id @default(cuid())
  propertyId    String
  property      Property   @relation(fields: [propertyId], references: [id])
  title         String
  category      String
  description   String?
  fileUrl       String
  storageProvider String   @default("EXTERNAL")
  storageKey    String?
  sha256        String?
  documentDate  DateTime?
  visibility    Visibility @default(RESTRICTED)
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt

  @@index([propertyId, category])
}

model TaxRecord {
  id            String   @id @default(cuid())
  propertyId    String
  property      Property @relation(fields: [propertyId], references: [id])
  taxType       String
  period        String
  amount        Decimal  @db.Decimal(12, 2)
  dueDate       DateTime?
  paidAt        DateTime?
  receiptUrl    String?
  notes         String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([propertyId, taxType, period])
}
